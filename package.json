{
  "name": "slack-codex-workers",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/agents/main.ts",
    "agents": "tsx src/agents/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/agents/main.js",
    "launch": "bash scripts/launch.sh",
    "launch:prod": "bash scripts/launch.sh --prod",
    "provision": "tsx scripts/provision-app.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/tests"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@slack/bolt": "^5.1.0",
    "dotenv": "^18.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
