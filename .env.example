SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=unused-for-socket-mode
SLACK_ADMIN_USER_IDS=U01234567
SLACK_ALLOWED_TEAM_ID=
CODEX_BIN=codex
WORKSPACE_ROOT=/absolute/path/to/your/project
# Optional overrides. By default, bridge state lives under WORKSPACE_ROOT/.slack-workers/bridge/
# DATABASE_PATH=/absolute/path/to/your/project/.slack-workers/bridge/bridge.sqlite
MESSAGE_EDIT_THROTTLE_MS=1200
# SUPERVISOR_RESTART_ENABLED is set automatically by ./scripts/launch.sh
# ATTACHMENT_STORAGE_DIR=/absolute/path/to/your/project/.slack-workers/bridge/attachments
ATTACHMENT_MAX_BYTES=1073741824
ATTACHMENT_TOTAL_MAX_BYTES=off
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=600000
ATTACHMENT_RETENTION_MS=off
SLACK_UPLOAD_TIMEOUT_MS=600000
SLACK_UPLOAD_MAX_FILES=10
SHOW_SLACK_WORKLOG=0
WORKSPACE_TIMEZONE=America/Los_Angeles
PORT=3013
WEBHOOK_PORT=3014
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_PATH=/webhooks
WEBHOOK_BODY_MAX_BYTES=262144
WEBHOOK_BODY_READ_TIMEOUT_MS=30000
# Enable when running a trusted local tunnel/proxy such as cloudflared on the same machine.
# WEBHOOK_TRUST_LOOPBACK_PROXY=1
# WEBHOOK_PAYLOAD_STORAGE_DIR=/absolute/path/to/your/project/.slack-workers/bridge/webhooks
# WEBHOOK_SHARED_SECRET=replace-me-or-leave-unset-to-generate-on-first-boot
# WEBHOOK_PREVIOUS_SHARED_SECRET=previous-secret-during-initial-rotation-window
# WEBHOOK_PUBLIC_BASE_URL=https://hooks.example.com
