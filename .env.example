SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=unused-for-socket-mode
SLACK_ADMIN_USER_IDS=U01234567
SLACK_ALLOWED_TEAM_ID=
CODEX_BIN=codex
WORKSPACE_ROOT=/absolute/path/to/your/project
# Optional overrides. By default, bridge state lives under WORKSPACE_ROOT/.slack-codex-workers/
# DATABASE_PATH=/absolute/path/to/your/project/.slack-codex-workers/bridge.sqlite
MESSAGE_EDIT_THROTTLE_MS=1200
# SUPERVISOR_RESTART_ENABLED is set automatically by ./scripts/launch.sh
# ATTACHMENT_STORAGE_DIR=/absolute/path/to/your/project/.slack-codex-workers/attachments
ATTACHMENT_MAX_BYTES=1073741824
ATTACHMENT_TOTAL_MAX_BYTES=off
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=600000
ATTACHMENT_RETENTION_MS=off
SLACK_UPLOAD_TIMEOUT_MS=600000
SLACK_UPLOAD_MAX_FILES=10
PORT=3013
