# The one Slack app every agent speaks through (scripts/provision-app.ts creates it).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# TypeSafe key for the judgment model (Jev) that decides who each message is for. Without it, plain rules apply.
TYPESAFE_API_KEY=

# Slack user ids allowed to use operator commands (.status, .stop, .compact, .reset) in an agent's DM.
SLACK_ADMIN_USER_IDS=U01234567

# Optional. Defaults shown.
# AGENTS_STATE_ROOT=~/.slack-agents
# AGENTS_FILE=~/.slack-agents/agents.json
# WORKSPACE_TIMEZONE=America/Los_Angeles
# CODEX_BIN=codex
# AGENT_WAKE_BUDGET=8
# THREAD_CONTEXT_LIMIT=12
# ATTACHMENT_MAX_BYTES=1073741824
# SLACK_UPLOAD_MAX_FILES=10

# The tool server agents fetch the bridge's tools from. Agents on this machine use loopback. For an agent on another
# machine, set both: the address to listen on (one that machine can reach) and the URL it should use.
# TOOL_SERVER_PORT=3015
# TOOL_SERVER_BIND_HOST=0.0.0.0
# TOOL_SERVER_PUBLIC_URL=http://mini.tailnet:3015/mcp

# Inbound webhooks. WEBHOOK_PORT=off turns the listener off.
# WEBHOOK_PORT=3014
# WEBHOOK_BIND_HOST=127.0.0.1
# WEBHOOK_PATH=/webhooks
# WEBHOOK_PUBLIC_BASE_URL=https://hooks.example.com
# Enable when a trusted local tunnel or proxy such as cloudflared fronts the listener on this machine.
# WEBHOOK_TRUST_LOOPBACK_PROXY=1

# For scripts/provision-app.ts: an app configuration token from api.slack.com/apps.
# SLACK_CONFIG_TOKEN=xoxe.xoxp-...
# SLACK_CONFIG_REFRESH_TOKEN=xoxe-...
