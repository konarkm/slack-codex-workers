# One pair per named agent: SLACK_BOT_TOKEN_<NAME> and SLACK_APP_TOKEN_<NAME> (name upper-cased, hyphens as underscores).
SLACK_BOT_TOKEN_ADA=xoxb-your-bot-token
SLACK_APP_TOKEN_ADA=xapp-your-app-level-token

# Slack user ids allowed to use operator commands (.status, .stop, .compact, .reset) in an agent's DM.
SLACK_ADMIN_USER_IDS=U01234567

# Optional. Defaults shown.
# AGENTS_STATE_ROOT=~/.slack-agents
# AGENTS_FILE=~/.slack-agents/agents.json
# WORKSPACE_TIMEZONE=America/Los_Angeles
# CODEX_BIN=codex
# AGENT_WAKE_BUDGET=8
# THREAD_CONTEXT_LIMIT=12
# ATTACHMENT_MAX_BYTES=1073741824
# SLACK_UPLOAD_MAX_FILES=10

# Inbound webhooks. WEBHOOK_PORT=off turns the listener off.
# WEBHOOK_PORT=3014
# WEBHOOK_BIND_HOST=127.0.0.1
# WEBHOOK_PATH=/webhooks
# WEBHOOK_PUBLIC_BASE_URL=https://hooks.example.com
# Enable when a trusted local tunnel or proxy such as cloudflared fronts the listener on this machine.
# WEBHOOK_TRUST_LOOPBACK_PROXY=1

# For scripts/provision-agent.ts: an app configuration token from api.slack.com/apps.
# SLACK_CONFIG_TOKEN=xoxe.xoxp-...
# SLACK_CONFIG_REFRESH_TOKEN=xoxe-...
